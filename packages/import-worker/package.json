{
  "name": "@letschurch/import-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/index.ts",
    "start": "NODE_ENV=production tsx src/index.ts",
    "check": "pnpm run /^check:/",
    "check:fmt": "oxfmt --check",
    "check:lint": "oxlint",
    "check:ts": "tsc --noEmit",
    "fix": "oxfmt && oxlint --fix",
    "fix!": "oxfmt && oxlint --fix-dangerously"
  },
  "dependencies": {
    "@letschurch/temporal": "workspace:*",
    "@sentry/node": "catalog:",
    "@temporalio/worker": "catalog:",
    "es-toolkit": "catalog:",
    "execa": "^9.6.0",
    "playwright": "^1.56.1",
    "tsx": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  }
}
