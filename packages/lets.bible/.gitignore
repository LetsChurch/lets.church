# Build output (TanStack Start / Vite / Nitro) — matches packages/web
.nitro
.output
.tanstack
.vite
dist
storybook-static

# Build-time precompressed assets (Nitro compressPublicAssets) — generated, never
# committed.
*.br
*.gz
# …except the vendored STEPBible interlinear data (CC BY 4.0), which IS committed
# gzip-compressed so the seed has no deploy-time network dependency.
!/seed/stepbible/*.gz

# Generated client-side search + reading assets — built from the committed USX
# seed (no DB) by `pnpm build` (runs build-flex-index.ts before `vite build`, so
# they ship in the image); regenerate for dev with `just lb-flex`.
/public/search/
/public/reading/
/public/overlays/

# Note: seed/overlays/{index,cross-references}.json are the committed, authoritative
# source-text-overlay + cross-reference data (NOT ignored). public/overlays/ above is
# just the build-time copy build-flex-index.ts publishes for the client to fetch.

# Downloaded SWORD modules for commentary extraction (scripts/sword/). The
# extracted artifacts under seed/commentaries/*.json are the committed source;
# the raw modules are a regenerable local cache.
/seed/.sword/

# Playwright e2e
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Downloaded eBible WEB USFM (regenerable cache; the committed artifact is
# the converted USX under seed/web/USX_1 — see scripts/web/build-web-usx.ts).
/seed/.web-usfm/
