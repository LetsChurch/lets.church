{
  "name": "@letschurch/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "build": "drizzle-kit generate",
    "check": "pnpm run /^check:/",
    "check:fmt": "oxfmt --check",
    "check:lint": "oxlint",
    "check:ts": "tsc --noEmit",
    "fix": "oxfmt && oxlint --fix",
    "fix!": "oxfmt && oxlint --fix-dangerously",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:truncate": "DB_LOG=0 tsx prisma/truncate.ts",
    "test:schema-parity": "tsx --test src/schema-parity.test.ts"
  },
  "dependencies": {
    "@letschurch/util": "workspace:*",
    "drizzle-orm": "catalog:",
    "es-toolkit": "catalog:",
    "pg": "catalog:",
    "tsx": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-kit": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "uuid": "catalog:"
  }
}
