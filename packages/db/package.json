{
  "name": "@letschurch/db",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "build": "drizzle-kit generate",
    "check": "pnpm run /^check:/",
    "check:biome": "biome check",
    "check:ts": "tsc --noEmit",
    "fix": "biome check --write",
    "fix!": "biome check --write --unsafe",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:truncate": "tsx prisma/truncate.ts"
  },
  "dependencies": {
    "@letschurch/util": "workspace:*",
    "drizzle-orm": "catalog:",
    "es-toolkit": "catalog:",
    "pg": "catalog:",
    "tsx": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:",
    "uuid": "catalog:"
  }
}
