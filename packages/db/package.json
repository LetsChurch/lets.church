{
  "name": "@letschurch/db",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./generated/prisma/client": "./src/generated/prisma/client.ts"
  },
  "scripts": {
    "build": "prisma generate",
    "check": "pnpm run /^check:/",
    "check:biome": "biome check",
    "check:ts": "prisma generate && tsc --noEmit",
    "fix": "biome check --write",
    "fix!": "biome check --write --unsafe",
    "prisma:studio": "prisma studio",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:test": "prisma db push --accept-data-loss",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:migrate:reset": "prisma migrate reset",
    "prisma:db:push": "prisma db push",
    "prisma:db:push:force": "prisma db push --accept-data-loss",
    "prisma:db:truncate": "tsx prisma/truncate.ts",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@letschurch/util": "workspace:*",
    "@prisma/client": "6.19.0",
    "es-toolkit": "catalog:",
    "prisma": "^6.19.0",
    "tsx": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "uuid": "catalog:"
  }
}
