{
  "$schema": "https://biomejs.dev/schemas/2.3.4/schema.json",
  "extends": ["../../biome.json"],
  "vcs": {
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "src/**/*",
      "!src/generated/**/*",
      "!**/*.gen.*",
      "!**/*.module.css.d.ts",
      "./*"
    ]
  },
  "linter": {
    "rules": {
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": "@letschurch/temporal/activities/*",
                "message": "Do not import temporal activities"
              }
            ]
          }
        }
      },
      "nursery": {
        "useSortedClasses": "error"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
