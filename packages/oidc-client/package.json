{
  "name": "@letschurch/oidc-client",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "check": "pnpm run /^check:/",
    "check:biome": "biome check",
    "check:ts": "tsc --noEmit",
    "fix": "biome check --write",
    "fix!": "biome check --write --unsafe"
  },
  "dependencies": {
    "jose": "^6.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
