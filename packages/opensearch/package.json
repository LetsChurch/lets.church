{
  "name": "@letschurch/opensearch",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "check": "pnpm run /^check:/",
    "check:fmt": "oxfmt --check",
    "check:lint": "oxlint",
    "check:ts": "tsc --noEmit",
    "fix": "oxfmt && oxlint --fix",
    "fix!": "oxfmt && oxlint --fix-dangerously",
    "push-mappings": "tsx src/mappings.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@letschurch/util": "workspace:*",
    "@opensearch-project/opensearch": "^3.6.0",
    "jest-diff": "^30.2.0",
    "picocolors": "^1.1.1",
    "tsx": "catalog:",
    "type-fest": "catalog:",
    "wait-on": "catalog:",
    "xss": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/wait-on": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
