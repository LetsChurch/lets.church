{
  "name": "@letschurch/s3",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./ingest": "./src/ingest.ts",
    "./public": "./src/public.ts",
    "./backup": "./src/backup.ts"
  },
  "scripts": {
    "check": "pnpm run /^check:/",
    "check:fmt": "oxfmt --check",
    "check:lint": "oxlint",
    "check:ts": "tsc --noEmit",
    "fix": "oxfmt && oxlint --fix",
    "fix!": "oxfmt && oxlint --fix-dangerously"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/s3-request-presigner": "catalog:",
    "@letschurch/util": "workspace:*",
    "es-toolkit": "catalog:",
    "p-map": "catalog:",
    "p-retry": "catalog:",
    "pino": "catalog:",
    "sanitize-filename": "^1.6.3",
    "type-fest": "catalog:",
    "uuid": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  }
}
