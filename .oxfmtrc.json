{
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 80,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "sortPackageJson": true,
  "sortImports": true,
  "sortTailwindcss": true,
  "ignorePatterns": [
    "**/*.gen.*",
    "**/*.module.css.d.ts",
    "**/generated/**",
    "**/drizzle/**",
    "**/prisma/**",
    "**/seed/**",
    "**/public/**"
  ]
}
