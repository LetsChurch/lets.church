{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "tags": [
    "-lintignore"
  ],
  "ignore": [
    "seed-data/**"
  ],
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": "scripts/*.ts"
    },
    "packages/web": {
      "entry": [
        "src/routeTree.gen.ts!",
        "src/router.tsx",
        "src/temporal/workers/background-worker.ts",
        "src/temporal/workers/transcribe-worker.ts",
        "src/temporal/activities/*/index.ts",
        "src/temporal/workflows/index.ts",
        "vite.config.ts",
        ".storybook/main.ts",
        "src/app.css"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        ".storybook/**/*.{ts,tsx}"
      ],
      "storybook": {
        "config": [".storybook/main.ts"],
        "entry": ["src/**/*.stories.{ts,tsx}"]
      },
      "ignoreBinaries": [
        "audiowaveform",
        "convert",
        "oxipng",
        "jpegoptim",
        "whisper-ctranslate2"
      ]
    },
    "packages/db": {
      "entry": [
        "src/index.ts",
        "prisma/seed/dev.ts"
      ],
      "project": [
        "src/**/*.ts",
        "prisma/seed/**/*.ts",
        "prisma/truncate.ts"
      ],
      "ignoreDependencies": ["@prisma/client"]
    },
    "packages/elasticsearch": {},
    "packages/s3": {},
    "packages/util": {
      "entry": "src/index.ts",
      "ignoreDependencies": ["@axiomhq/pino", "pino-pretty"]
    },
    "packages/import-worker": {
      "entry": "src/index.ts",
      "ignoreBinaries": ["yt-dlp", "ffmpeg"]
    },
    "packages/probe-worker": {
      "entry": "src/index.ts",
      "ignoreBinaries": ["ffmpeg", "ffprobe"]
    },
    "packages/transcode-worker": {
      "entry": "src/index.ts",
      "ignoreBinaries": ["audiowaveform", "convert", "ffmpeg", "ffprobe", "oxipng", "jpegoptim"]
    }
  }
}
