# The primary checkout. Linked worktrees (`git worktree`, worktrunk's `wt`,
# Claude's .claude/worktrees/*) share its git dir, inherit its .envrc.local, and
# run their own app stack against the shared infrastructure (docs/worktrees.md).
export LC_MAIN_ROOT=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")

# Parent .envrc files (what `source_up_if_exists` does), but searched from the
# primary checkout's parent: a worktree nested inside the primary checkout
# (.claude/worktrees/*) would otherwise pick up the primary's .envrc.
lc_dir=$(dirname "$LC_MAIN_ROOT")
while [ "$lc_dir" != / ]; do
  if [ -f "$lc_dir/.envrc" ]; then
    source_env "$lc_dir/.envrc"
    break
  fi
  lc_dir=$(dirname "$lc_dir")
done
unset lc_dir

if ! has nix_direnv_version || ! nix_direnv_version 3.0.6; then
  source_url "https://raw.githubusercontent.com/nix-community/nix-direnv/3.0.6/direnvrc" "sha256-RYcUJaRMf8oF5LznDrlCXbkOQrywm0HDv1VjYGaJGdM="
fi

use nix

# Secrets and personal settings. A worktree starts from the primary checkout's
# .envrc.local (API keys etc.), then applies its own on top.
if [ "$PWD" != "$LC_MAIN_ROOT" ]; then
  source_env_if_exists "$LC_MAIN_ROOT/.envrc.local"
fi
source_env_if_exists ./.envrc.local

# `git config --local` is shared by every worktree, so these must not depend on
# which checkout ran last: hooksPath is resolved relative to each worktree root.
# Written only when different: concurrent loads (e.g. parallel worktrunk hooks)
# would otherwise race on .git/config's lock.
[ "$(git config --local core.hooksPath)" = .githooks ] ||
  git config --local core.hooksPath .githooks
[ "$(git config --local gpg.ssh.allowedSignersFile)" = "$LC_MAIN_ROOT/allowed_signers" ] ||
  git config --local gpg.ssh.allowedSignersFile "$LC_MAIN_ROOT/allowed_signers"

# Set environment variables
set -a

# Checkout identity. The primary checkout is `main` and keeps the historical
# names (database `letschurch`, unprefixed indices, namespace `default`), so
# existing data keeps working. Every other worktree derives
# its name from its directory (worktrunk's `lets.church.<branch>` becomes
# `<branch>`), lowercased and DNS-safe; set LC_WT in its .envrc.local to pick
# another.
if [ "$PWD" = "$LC_MAIN_ROOT" ]; then
  : ${LC_WT:=main}
else
  lc_name=$(basename "$PWD")
  lc_name=${lc_name#"$(basename "$LC_MAIN_ROOT")."}
  : ${LC_WT:=$(printf '%s' "$lc_name" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | cut -c1-40 | sed 's/^-*//; s/-*$//')}
  unset lc_name
fi

# Where per-machine dev state lives (Traefik certs and routes).
: ${LC_DEV_HOME:=${XDG_DATA_HOME:-$HOME/.local/share}/letschurch-dev}

if [ "$LC_WT" = main ]; then
  : ${COMPOSE_PROJECT_NAME:=letschurch_dev}
  : ${LC_PG_DATABASE:=letschurch}
  : ${LC_LB_PG_DATABASE:=letsbible}
  : ${OPENSEARCH_INDEX_PREFIX:=}
  : ${TEMPORAL_NAMESPACE:=default}
  : ${LC_VALKEY_DB:=0}
  : ${COMPOSE_PROFILES:=storybook,webhooks,transcribe}
else
  lc_ident=$(printf '%s' "$LC_WT" | tr - _)
  : ${COMPOSE_PROJECT_NAME:=lc-$LC_WT}
  : ${LC_PG_DATABASE:=letschurch_$lc_ident}
  : ${LC_LB_PG_DATABASE:=letsbible_$lc_ident}
  : ${OPENSEARCH_INDEX_PREFIX:=${LC_WT}__}
  : ${TEMPORAL_NAMESPACE:=lc-$LC_WT}
  # Logical Valkey DB 1-255 (0 is the primary checkout's). A hash collision
  # only means two worktrees share a cache, never data.
  : ${LC_VALKEY_DB:=$(( $(printf '%s' "$LC_WT" | cksum | cut -d' ' -f1) % 255 + 1 ))}
  # The webhook forwarders and storybooks are opt-in per worktree; the
  # transcribe worker is too (several GB of models) — without it uploads
  # stop at transcription.
  : ${COMPOSE_PROFILES:=}
  unset lc_ident
fi

# Every checkout is served over HTTPS by the shared Traefik router
# (docs/worktrees.md). `LC_ROUTING=ports` in .envrc.local serves
# http://localhost:4000 (web) and :4001 (lets.bible) instead, one checkout at a
# time.
: ${LC_ROUTING:=https}
LC_WEB_HOST=$LC_WT.lc.localhost
LC_LB_HOST=$LC_WT.lb.localhost
LC_WEB_HOST_RE=$(printf '%s' "$LC_WEB_HOST" | sed 's/\./\\./g')

if [ "$LC_ROUTING" = https ]; then
  # Assigned, not defaulted: a worktree must not inherit the primary
  # checkout's URLs from its .envrc.local.
  HOST_WEB_URL=https://$LC_WEB_HOST
  HOST_LETS_BIBLE_URL=https://$LC_LB_HOST
  HOST_IMGPROXY_URL=https://imgproxy.infra.localhost
  HOST_DOWNLOAD_URL=https://download.infra.localhost
  : ${COMPOSE_FILE:=docker-compose.yml}
else
  : ${COMPOSE_FILE:=docker-compose.yml:docker-compose.ports.yml}
fi

: ${HOST_WEB_PORT:=4000}
: ${HOST_WEB_URL:=http://localhost:${HOST_WEB_PORT##*:}}
: ${HOST_EXTERNAL_HOOKS_PORT:=4200}
: ${HOST_TEMPORAL_UI_PORT:=4400}
: ${HOST_TEMPORAL_PORT:=4401}
: ${HOST_FAKTORY_PORT:=4402}
: ${HOST_FAKTORY_UI_PORT:=4403}
: ${HOST_OPENSEARCH_PORT:=4500}
: ${HOST_VALKEY_PORT:=4550}
: ${HOST_MAILPIT_WEB_PORT:=4600}
: ${HOST_MAILPIT_SMTP_PORT:=4601}
: ${HOST_MAILPIT_SMTPS_PORT:=4602}
: ${HOST_IMGPROXY_PORT:=4700}
: ${HOST_LISTMONK_PORT:=4800}
: ${HOST_DOWNLOAD_PORT:=4900}
: ${HOST_PG_PORT:=5432}
: ${HOST_PGWEB_PORT:=5001}
: ${HOST_METABASE_PORT:=5002}
: ${HOST_STORYBOOK_PORT:=6006}

: ${LISTMONK_USER:=admin}
: ${LISTMONK_PASSWORD:=password}
: ${LISTMONK_API_USER:=api}       # Must create this user in the admin UI
: ${LISTMONK_API_TOKEN:=generate} # Must generate and add to .envrc.local

: ${ZXCVBN_MINIMUM_SCORE:=3}

# openssl rand -hex 64
: ${JWT_SECRET:=a5f09624d6106947a62e904ef1f31d880e3c4dde7ac74d67828c197a7f72ec973ca5ccae1210ddad78e590b3734511c0a943fe8ed366640ffb09d5edc9da097a}
: ${WEB_COOKIE_SECRET:=e2a89731470feda4c198ea66523cc4cf8096bf61e1f5c4256f9d19136482a4a8b30af8d1e970d539f1f0c92954e3a769e6348d26586f2553db90e2192fff8c51}
: ${IMGPROXY_KEY:=ce64d4682be60431078d48cc71a98679ea90a91547f492cd549c1e32ce5d7d22a75583564af74712276d87966b7f6dc1e3fef9b6e627d365415879defab6da73}
: ${IMGPROXY_SALT:=715594d026d44c1476569fd74000f919c2595a3f9937704ebb541c26e7672edf7fd3db90243723cb1525b915cc5c672a4cb53190d2793991ad8c4a1fa418be80}

: ${WEB_URL:=$HOST_WEB_URL}

# Embedded OIDC provider. OIDC_ISSUER is the public origin clients see; in dev it
# matches the web URL. OIDC_SIGNING_JWK is a dev-only EC P-256 (ES256) private
# JWK — generate a fresh one per environment, never reuse this in production:
#   node -e "crypto.subtle.generateKey({name:'ECDSA',namedCurve:'P-256'},true,['sign','verify']).then(async k=>{const j=await crypto.subtle.exportKey('jwk',k.privateKey);console.log(JSON.stringify({kty:j.kty,crv:j.crv,x:j.x,y:j.y,d:j.d,kid:'key-1',alg:'ES256',use:'sig'}))})"
: ${OIDC_ISSUER:=${WEB_URL}}
: ${OIDC_SIGNING_JWK:='{"kty":"EC","crv":"P-256","x":"LiETEXU4MmtA2yq9-vPkCsp7yzOQQAmHH_2wH1mmgGA","y":"QIqRAZMzIS9JapxRad_Dtbb0jbVaiEGU7ECc9WWxBv0","d":"NTiALuTtTJg3ZB1CHeEphdbfwNSWANvX9DkYaRLFNXs","kid":"dev-1","alg":"ES256","use":"sig"}'}

# lets.bible app (packages/lets.bible), served on :4001. It is a public
# PKCE-only OIDC client (the `lets.bible` client declared in the provider), so
# it needs no secret.
: ${HOST_LETS_BIBLE_PORT:=4001}
: ${HOST_LETS_BIBLE_STORYBOOK_PORT:=6007}
: ${HOST_LETS_BIBLE_URL:=http://localhost:${HOST_LETS_BIBLE_PORT##*:}}
: ${OIDC_LETS_BIBLE_REDIRECT_URI:=$HOST_LETS_BIBLE_URL/callback}
: ${OIDC_LETS_BIBLE_POST_LOGOUT_URI:=$HOST_LETS_BIBLE_URL/}
# Base URL the web app uses to link scripture references into lets.bible (the
# Bible-reference pills in transcripts / media info). Prod: https://lets.bible.
: ${VITE_LETS_BIBLE_URL:=$HOST_LETS_BIBLE_URL}
# lets.bible Playwright target (packages/lets.bible/playwright.config.ts).
: ${LETS_BIBLE_E2E_URL:=$HOST_LETS_BIBLE_URL}

: ${HOST_IMGPROXY_URL:=http://localhost:${HOST_IMGPROXY_PORT##*:}}
: ${HOST_DOWNLOAD_URL:=http://localhost:${HOST_DOWNLOAD_PORT##*:}}

: ${PG_USER:=letschurch}
: ${PG_PASSWORD:=password}
: ${PG_DATABASE:=$PG_USER}
: ${HOST_DATABASE_URL:=postgres://$PG_USER:$PG_PASSWORD@localhost:${HOST_PG_PORT##*:}/$LC_PG_DATABASE}

: ${HOST_OPENSEARCH_URL:=http://localhost:${HOST_OPENSEARCH_PORT##*:}}
: ${OPENSEARCH_URL:=$HOST_OPENSEARCH_URL}

: ${MAPBOX_GEOCODING_TOKEN:=token}
: ${MAPBOX_MAP_TOKEN:=token}
: ${MAPBOX_SEARCHBOX_TOKEN:=token}

# Mux live streaming. Set real API token values in .envrc.local.
: ${MUX_TOKEN_ID:=token}
: ${MUX_TOKEN_SECRET:=secret}
# MUX_WEBHOOK_SECRET is Mux's GENERATED signing secret (printed by the
# mux-webhooks `mux webhooks listen` service, or from the dashboard webhook) —
# you can't choose it. Leave it UNSET in dev to skip signature verification so
# you can POST synthetic webhooks to /webhooks/mux; set it only when you want
# to verify real forwarded events. It is required in production.
# : ${MUX_WEBHOOK_SECRET:=}

: ${SENTRY_WEB_SERVER_DSN:=https://foo@bar.ingest.sentry.io/baz}
: ${SENTRY_GATEWAY_DSN:=https://foo@bar.ingest.sentry.io/baz}
: ${SENTRY_BACKGROUND_WORKER_DSN:=https://foo@bar.ingest.sentry.io/baz}
: ${SENTRY_TRANSCODE_WORKER_DSN:=https://foo@bar.ingest.sentry.io/baz}
: ${SENTRY_TRANSCRIBE_WORKER_DSN:=https://foo@bar.ingest.sentry.io/baz}
: ${SENTRY_IMPORT_WORKER_DSN:=https://foo@bar.ingest.sentry.io/baz}

# Storage locations (see packages/s3/README.md#storage-locations). Each
# location id pairs one ingest bucket with one public bucket and is discovered
# from STORAGE_<ID>_*_BUCKET key names. Existing data lives at `idrive`.
: ${STORAGE_IDRIVE_INGEST_REGION:=us-east-1}
: ${STORAGE_IDRIVE_INGEST_ENDPOINT:=s3endpoint}
: ${STORAGE_IDRIVE_INGEST_BUCKET:=s3bucket}
: ${STORAGE_IDRIVE_INGEST_ACCESS_KEY_ID:=accesskeyid}
: ${STORAGE_IDRIVE_INGEST_SECRET_ACCESS_KEY:=secretaccesskey}

: ${STORAGE_IDRIVE_PUBLIC_REGION:=us-east-1}
: ${STORAGE_IDRIVE_PUBLIC_ENDPOINT:=s3endpoint}
: ${STORAGE_IDRIVE_PUBLIC_BUCKET:=s3bucket}
: ${STORAGE_IDRIVE_PUBLIC_ACCESS_KEY_ID:=accesskeyid}
: ${STORAGE_IDRIVE_PUBLIC_SECRET_ACCESS_KEY:=secretaccesskey}
# Public CDN base URL for the idrive public bucket (no trailing slash).
: ${STORAGE_IDRIVE_PUBLIC_URL:=https://public_media_url}

# Optional second location (`rustfs`) for exercising multi-location storage.
# Set STORAGE_RUSTFS_* in .envrc.local; an empty BUCKET leaves it ignored.

# imgproxy fetches originals over HTTP and only from these prefixes. imgproxy
# treats each comma-separated entry as an anchored prefix, so every entry ends
# in `/` (otherwise https://cdn.example.com would also match
# https://cdn.example.com.evil.test/). Never emit an empty entry: an empty
# pattern matches every URL.
if [ -z "${IMGPROXY_ALLOWED_SOURCES:-}" ]; then
  IMGPROXY_ALLOWED_SOURCES="${STORAGE_IDRIVE_PUBLIC_URL%/}/"
  if [ -n "${STORAGE_RUSTFS_PUBLIC_URL:-}" ]; then
    IMGPROXY_ALLOWED_SOURCES="${IMGPROXY_ALLOWED_SOURCES},${STORAGE_RUSTFS_PUBLIC_URL%/}/"
  fi
fi

: ${S3_BACKUP_REGION:=us-east-1}
: ${S3_BACKUP_ENDPOINT:=s3endpoint}
: ${S3_BACKUP_BUCKET:=backupbucket}
: ${S3_BACKUP_ACCESS_KEY_ID:=accesskeyid}
: ${S3_BACKUP_SECRET_ACCESS_KEY:=secretaccesskey}

: ${RCLONE_TRANSFERS:=16}
: ${RCLONE_CHECKERS:=32}

: ${RCLONE_CONFIG_LCDEVS3_TYPE:=s3}
: ${RCLONE_CONFIG_LCDEVS3_PROVIDER:=Other}
: ${RCLONE_CONFIG_LCDEVS3_ENDPOINT:=$STORAGE_IDRIVE_PUBLIC_ENDPOINT}
: ${RCLONE_CONFIG_LCDEVS3_ACCESS_KEY_ID:=$STORAGE_IDRIVE_PUBLIC_ACCESS_KEY_ID}
: ${RCLONE_CONFIG_LCDEVS3_SECRET_ACCESS_KEY:=$STORAGE_IDRIVE_PUBLIC_SECRET_ACCESS_KEY}

: ${RCLONE_CONFIG_LCDEVS3BACKUP_TYPE:=s3}
: ${RCLONE_CONFIG_LCDEVS3BACKUP_PROVIDER:=Other}
: ${RCLONE_CONFIG_LCDEVS3BACKUP_ENDPOINT:=$S3_BACKUP_ENDPOINT}
: ${RCLONE_CONFIG_LCDEVS3BACKUP_ACCESS_KEY_ID:=$S3_BACKUP_ACCESS_KEY_ID}
: ${RCLONE_CONFIG_LCDEVS3BACKUP_SECRET_ACCESS_KEY:=$S3_BACKUP_SECRET_ACCESS_KEY}

: ${RCLONE_CONFIG_MAPTILES_TYPE:=s3}
: ${RCLONE_CONFIG_MAPTILES_PROVIDER:=Other}
: ${RCLONE_CONFIG_MAPTILES_ENDPOINT:=$STORAGE_IDRIVE_PUBLIC_ENDPOINT}
: ${RCLONE_CONFIG_MAPTILES_ACCESS_KEY_ID:=$STORAGE_IDRIVE_PUBLIC_ACCESS_KEY_ID}
: ${RCLONE_CONFIG_MAPTILES_SECRET_ACCESS_KEY:=$STORAGE_IDRIVE_PUBLIC_SECRET_ACCESS_KEY}

: ${ANSIBLE_INVENTORY:=$PWD/infra/ansible/hosts.yml}
: ${ANSIBLE_ROLES_PATH:=$PWD/infra/ansible/roles}
: ${ANSIBLE_COLLECTIONS_PATH:=$PWD/infra/ansible/collections}

: ${INFISICAL_CLIENT_ID:=your-client-id}
: ${INFISICAL_CLIENT_SECRET:=your-client-secret}

: ${ADMIN_EMAIL:=contact@lets.church}

# PagerDuty Events API v2 routing key for media-pipeline failure alerts.
# Optional: when unset, the triggerPagerDutyAlert activity is a no-op.
: ${PAGERDUTY_ROUTING_KEY:=}

# Public, responder-reachable base URL of the Temporal UI, used to deep-link
# PagerDuty alerts to the failing workflow execution (e.g.
# https://temporal-ui.example.ts.net). Optional: when unset, alerts simply
# omit the Temporal link. The dashboard link reuses WEB_URL.
: ${TEMPORAL_UI_PUBLIC_URL:=}

set +a
# End setting environment variables

path_add NAVI_PATH ./navi
