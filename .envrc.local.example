export ZXCVBN_MINIMUM_SCORE=0

# Embedded OIDC provider. The `.envrc` ships a dev signing key and defaults the
# issuer to the web URL. Clients are public (PKCE-only) and declared entirely in
# code in packages/web/src/util/oidc/clients.ts — no per-client secrets or env
# vars. To add a client, add an entry to that file.

export SENTRY_WEB_SERVER_DSN=https://foo@bar.ingest.sentry.io/baz
export SENTRY_GATEWAY_DSN=https://foo@bar.ingest.sentry.io/baz
export SENTRY_BACKGROUND_WORKER_DSN=https://foo@bar.ingest.sentry.io/baz
export SENTRY_TRANSCODE_WORKER_DSN=https://foo@bar.ingest.sentry.io/baz
export SENTRY_TRANSCRIBE_WORKER=https://foo@bar.ingest.sentry.io/baz
export SENTRY_IMPORT_WORKER=https://foo@bar.ingest.sentry.io/baz

export MEDIA_URL=https://public_media_url

export MAPBOX_GEOCODING_TOKEN=
export MAPBOX_MAP_TOKEN=
export MAPBOX_SEARCHBOX_TOKEN=

export S3_INGEST_ENDPOINT=
export S3_INGEST_BUCKET=
export S3_INGEST_ACCESS_KEY_ID=
export S3_INGEST_SECRET_ACCESS_KEY=

export S3_PUBLIC_ENDPOINT=
export S3_PUBLIC_BUCKET=
export S3_PUBLIC_ACCESS_KEY_ID=
export S3_PUBLIC_SECRET_ACCESS_KEY=

export S3_BACKUP_ENDPOINT=
export S3_BACKUP_BUCKET=
export S3_BACKUP_ACCESS_KEY_ID=
export S3_BACKUP_SECRET_ACCESS_KEY=

export RCLONE_CONFIG_MAPTILES_ENDPOINT=
export RCLONE_CONFIG_MAPTILES_ACCESS_KEY_ID=
export RCLONE_CONFIG_MAPTILES_SECRET_ACCESS_KEY=

export ADMIN_EMAIL=admin@example.com

# PagerDuty Events API v2 routing key (optional; unset = no PagerDuty alerts)
export PAGERDUTY_ROUTING_KEY=

export OPENAI_API_KEY=
export OPENROUTER_API_KEY=
# Optional override. Default is openai/gpt-5.4-mini. Cheaper:
# openai/gpt-5.4-nano. Better quality: openai/gpt-5.4 or openai/gpt-5.5.
# export OPENROUTER_SUMMARY_MODEL=openai/gpt-5.4-mini

# Mux live streaming API token (Settings -> Access Tokens in the Mux dashboard).
# Grant it both Mux Video AND Mux System permissions — the mux-webhooks
# forwarder (`mux webhooks listen`) needs System; a Video-only token fails with
# "Permission denied or this route does not exist".
export MUX_TOKEN_ID=
export MUX_TOKEN_SECRET=
# Webhook signing secret. Mux GENERATES this — you can't choose the value.
# Leave UNSET in dev to skip signature verification; REQUIRED in production.
#
# In dev you don't need a dashboard webhook: run the mux-webhooks compose
# service (`mux webhooks listen --forward-to http://web:3000/webhooks/mux`),
# which forwards your environment's events to receive them and test the
# end-to-end flow, and prints a signing secret to copy here.
#
# In production you must create a webhook in the Mux dashboard
# (Settings -> Webhooks) pointing at https://<your-domain>/webhooks/mux and
# copy its signing secret here. Webhooks/secrets are per-environment in Mux.
# export MUX_WEBHOOK_SECRET=

export LISTMONK_USER=admin
export LISTMONK_PASSWORD=password
export LISTMONK_API_USER=api
export LISTMONK_API_TOKEN=generate

KUBECONFIG=$PWD/infra/kubeconfig.yaml

if [ -f $PWD/infra/kubeconfig.yaml ]; then
  export KUBECONFIG
fi

watch_file $KUBECONFIG
