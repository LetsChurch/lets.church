{
  "name": "web-next",
  "type": "module",
  "scripts": {
    "dev": "run-p dev:*",
    "dev:codegen": "bun ./wait.ts && bun run codegen -- -w src/routes/**/*.ts",
    "dev:vinxi": "vinxi dev --host",
    "codegen": "graphql-codegen --config codegen.yml",
    "build": "vinxi build",
    "start": "vinxi start",
    "check": "npm-run-all check:*",
    "check:lint": "eslint .",
    "check:format": "prettier --check .",
    "check:ts": "tsc",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
