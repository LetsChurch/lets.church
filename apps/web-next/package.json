    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "type-fest": "^4.30.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite-plugin-solid-svg": "^0.8.1",
    "wait-on": "^8.0.1"
