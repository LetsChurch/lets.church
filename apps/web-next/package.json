    "human-format": "^1.2.1",
    "human-number": "^2.0.4",
    "is-ip": "^5.0.1",
    "just-debounce": "^1.1.0",
    "just-group-by": "^2.2.0",
    "just-sort-by": "^3.2.0",
    "mapbox-gl": "^3.8.0",
    "p-progress": "^1.0.0",
    "p-retry": "^6.2.1",
    "plausible-tracker": "^0.3.9",
    "pluralize": "^8.0.0",
    "postcss": "^8.4.49",
    "pretty-ms": "^9.2.0",
    "slugify": "^1.6.6",
