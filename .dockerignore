# Git
.git

# Go build artifacts
services/download/download

# Build artifacts (generated during build stage)
packages/web/.nitro
packages/web/.output
packages/web/dist
packages/db/src/generated
packages/lets.bible/.nitro
packages/lets.bible/.output
packages/lets.bible/.tanstack
packages/lets.bible/dist
# lets.bible search + reading assets are regenerated in the build stage
# (`pnpm build` runs build-flex-index.ts before `vite build`) — don't ship the
# local copy into the build context.
packages/lets.bible/public/search
packages/lets.bible/public/reading
# Committed verse embeddings (git-lfs, ~731MB). Kept out of every image: dev
# reads them via the bind mount, and a remote index is (re)built out-of-band with
# `just lb-index-remote <host>`. Without them the image's init-container
# provisioning live-embeds instead (it has the OpenAI key).
packages/lets.bible/seed/embeddings

# Dependencies (installed during build stage)
**/node_modules
.pnpm-store

# Local data
seed-data
