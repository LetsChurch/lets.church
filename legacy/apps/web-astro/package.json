{
  "name": "web-astro",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "start": "bun ./dist/server/entry.mjs",
    "check": "run-s check:*",
    "check:astro": "astro check --tsconfig ./tsconfig.json",
    "check:lint": "eslint .",
    "check:ts": "tsc --noEmit",
    "check:prettier": "prettier --check .",
    "format": "prettier -w ."
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/node": "^9.0.0",
    "@sentry/astro": "^8.43.0",
    "astro": "^5.0.4",
    "drizzle-orm": "^0.38.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.30.0",
    "eslint": "^9.16.0",
    "globals": "^15.13.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  },
  "trustedDependencies": [
    "@sentry/cli"
  ]
