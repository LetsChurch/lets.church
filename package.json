{
  "name": "@letschurch/root",
  "type": "module",
  "private": true,
  "scripts": {
    "check": "pnpm run /^check:/",
    "check:fmt": "oxfmt --check scripts",
    "check:lint": "oxlint scripts",
    "check:ts": "tsc --noEmit",
    "fix": "oxfmt scripts && oxlint --fix scripts",
    "fix!": "oxfmt scripts && oxlint --fix-dangerously scripts",
    "s3:prune-multipart-uploads": "bun ./scripts/s3-prune-multipart-uploads.ts",
    "knip": "knip",
    "ncu": "ncu -iw --format group"
  },
  "packageManager": "pnpm@10.33.3",
  "license": "UNLICENSE",
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "@types/node": "catalog:",
    "knip": "^5.69.1",
    "npm-check-updates": "^19.2.0",
    "typescript": "catalog:"
  }
}
